# Anthropic
ANTHROPIC_API_KEY=

# Google OAuth (from credentials.json, Desktop app type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=

# Sandbox mode: when true, Gmail actions create DRAFTS instead of sending,
# and the agent only reads from the SANDBOX_SHEET_ID below rather than
# any live Do Good Institute sheet.
SANDBOX_MODE=true

# IDs for sandbox/test data (fill these in once you've made a copy of the
# real sheets/forms with synthetic data)
SANDBOX_FORM_ID=
SANDBOX_SHEET_ID=
SANDBOX_CALENDAR_ID=primary
